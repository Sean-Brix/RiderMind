{
  "name": "ridermind-functions",
  "description": "Firebase Cloud Functions for RiderMind",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "serve": "firebase emulators:start --only functions,firestore,storage,hosting",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "seed": "node --use-system-ca scripts/seedFirestore.js",
    "seed:firestore": "node --use-system-ca scripts/seedFirestore.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "sharp": "^0.34.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
